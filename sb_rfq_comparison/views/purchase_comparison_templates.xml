<odoo>
	<data>
		<template id="purchase_comparison" name="Purchase Comparison Chart">
			<t t-call="web.html_container">
				<div class="container">
					<br />
					<div style="display: flex; gap: 10px;">
						<form name="form_current_stock_report_xls" action="/web/purchase_comparison" method="post">
							<input type="hidden" id="rfq_ids" name="rfq_ids" t-att-value="rfq_ids"></input>
							<input type="hidden" name="purchase_comp_rpt_type" value="xls"/>
							<button type="submit" class="btn btn-primary">Export to Excel</button>
						</form>
						<form name="form_current_stock_report_pdf" action="/web/purchase_comparison" method="post">
							<input type="hidden" id="rfq_ids" name="rfq_ids" t-att-value="rfq_ids"></input>
							<input type="hidden" name="purchase_comp_rpt_type" value="pdf"/>
							<button type="submit" class="btn btn_sm btn-success">Export to PDF</button>
						</form>
					</div>
					<h3><t t-esc="company_name"/></h3>
					<style>
						.table-bordered-soft td,
						.table-bordered-soft th,
						.table-bordered-soft {
							border-width: 0.5px; border: 1px solid #ddd !important; /* lighter than default */
						}
					</style>
					<div class="row">
						<table class="table-striped table-bordered table-bordered-soft" style="font-size: 12px;">
							<body>
								<tr><td t-att-colspan="report_column"><h4 style="text-align: center;">Purchase Comparison Chart</h4></td></tr>
								<tr>
									<th>Reference</th>
									<t t-foreach="rfq_info" t-as="rfq">
										<th colspan="3" style="text-align:center;">
											<span t-esc="rfq['rfq_name']" />
										</th>
									</t>
								</tr>
								<tr>
									<th>Vendor</th>
									<t t-foreach="supplier" t-as="name">
										<th colspan="3" style="text-align:center;">
											<span t-esc="name['sname']" />
										</th>
									</t>
								</tr>
								<tr>
									<th>Products</th>
									<t t-foreach="rfq_info" t-as="rec">
										<th style="text-align:center;">Quantity</th>
										<th style="text-align:center;">Unit Price</th>
										<th style="text-align:center;">Subtotal</th>
									</t>
								</tr>
								<t t-foreach="data" t-as="product">
									<tr>
										<td><span t-esc="product['product_name']" /></td>
										<t t-foreach="product['record']" t-as="rec">
											<td><span t-esc="rec['qty']" /><span t-esc="rec['uom']" /></td>
											<td style="text-align:right;"><span t-esc="rec['price']" /></td>
											<td style="text-align:right;"><span t-esc="rec['subtotal']" /></td>
										</t>
									</tr>
								</t>
								<tr>
									<th>Total</th>
									<t t-foreach="rfq_info" t-as="rfq">
										<th colspan="3" style="text-align:center;">
											<span t-esc="rfq['amount']" />
										</th>
									</t>
								</tr>
							</body>
						</table>
					</div>
				</div>
			</t>
		</template>
	</data>
</odoo>